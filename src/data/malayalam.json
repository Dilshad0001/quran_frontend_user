{
  "1": {
    "name": "അൽ-ഫാതിഹ",
    "ayahs": [
      {
        "number": 1,
        "meaning": "കരുണാനിധിയായ അല്ലാഹുവിന്റെ നാമത്തിൽ തുടങ്ങുന്നു.",
        "explanation": "ഡമ്മി വിശദീകരണം: ആയത്ത് 1 ന്റെ മലയാള നിർവചനം."
      },
      {
        "number": 2,
        "meaning": "എല്ലാ പ്രശംസകളും ലോകങ്ങളുടേയും രക്ഷിതാവായ അല്ലാഹുവിനാണ്.",
        "explanation": "ഡമ്മി വിശദീകരണം: ആയത്ത് 2 ന്‍റെ വിശദീകരണം."
      },
      {
        "number": 3,
        "meaning": "അവൻ അതിയായ കരുണയുള്ളവനും ദയാനിധിയുമാണ്.",
        "explanation": "ഡമ്മി വിശദീകരണം: ആയത്ത് 3 ന്‍റെ വിശദീകരണം."
      },
      {
        "number": 4,
        "meaning": "ന്യായവിധി ദിവസത്തിന്റെ ഉടമ.",
        "explanation": "ഡമ്മി വിശദീകരണം: ആയത്ത് 4 ന്‍റെ വിശദീകരണം."
      },
      {
        "number": 5,
        "meaning": "നാം നിനക്കാണ് ആരാധിക്കുന്നത്, നിനക്കാണ് സഹായം അപേക്ഷിക്കുന്നത്.",
        "explanation": "ഡമ്മി വിശദീകരണം: ആയത്ത് 5 ന്‍റെ വിശദീകരണം."
      },
      {
        "number": 6,
        "meaning": "ഞങ്ങളെ നേരുള്ള വഴിയിൽ നടത്തേണമേ.",
        "explanation": "ഡമ്മി വിശദീകരണം: ആയത്ത് 6 ന്‍റെ വിശദീകരണം."
      },
      {
        "number": 7,
        "meaning": "കൃപനലിഞ്ഞവരുടെ വഴിയിലേക്ക്; ദോഷം വരുത്തപ്പെട്ടവരുടെയോ വഴിയിലേയ്ക്കല്ല.",
        "explanation": "ഡമ്മി വിശദീകരണം: ആയത്ത് 7 ന്‍റെ വിശദീകരണം."
      }
    ]
  }
}
